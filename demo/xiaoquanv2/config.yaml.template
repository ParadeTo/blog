feishu:
  app_id: "${FEISHU_APP_ID}"
  app_secret: "${FEISHU_APP_SECRET}"
  allowed_chats: []

llm:
  model: "claude-sonnet-4-6"
  embedding_model: "text-embedding-3-small"
  max_iter: 10
  temperature: 0.3

memory:
  workspace_dir: "./workspace"
  ctx_dir: "./data/ctx"
  db_dsn: "postgresql://postgres:postgres@localhost:5432/agent_memory"
  token_threshold: 80000
  prune_keep_turns: 10
  compress_threshold: 0.45
  fresh_keep_turns: 10

sandbox:
  image: "xiaoquan-sandbox:latest"
  timeout_ms: 30000
  mcp_port: 8022

session:
  data_dir: "./data/sessions"
  max_history_turns: 20

runner:
  idle_timeout_s: 300

sender:
  max_retries: 3
  retry_backoff: [1, 2, 4]

hooks:
  enabled: true
  dir: "./src/shared-hooks"
  fail_closed:
    - sandbox-guard
    - permission-gate
    - cost-guard
    - loop-detector
    - retry-tracker

security:
  audit_file: "./data/security_audit.jsonl"
  permissions:
    default: warn
    tools:
      list_skills: allow
      get_skill: allow
      memory_search: allow
      read_file: warn
      write_file: warn
      execute_code: warn
      run_script: warn
      sub_agent_echo: allow

observability:
  trace_to_langfuse: true
  langfuse_base_url: "${XIAOQUAN_LANGFUSE_BASE_URL}"
  langfuse_public_key: "${XIAOQUAN_LANGFUSE_PUBLIC_KEY}"
  langfuse_secret_key: "${XIAOQUAN_LANGFUSE_SECRET_KEY}"

retry:
  max_retries: 3

data_dir: "./data"

debug:
  enable_test_api: false
  test_api_port: 9090
  test_api_host: "127.0.0.1"
