# Langfuse Cloud or self-hosted instance.
# If these two keys are empty, the demo still runs locally and only prints JSON logs.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# OpenAI-compatible LLM endpoint.
# Defaults mirror demo/xiaoquan.
LANGFUSE_HOOKS_OPENAI_API_KEY=
LANGFUSE_HOOKS_OPENAI_API_BASE=http://localhost:3002/v1
LANGFUSE_HOOKS_AGENT_MODEL=gpt-5.4-nano-2026-03-17

# If LANGFUSE_HOOKS_OPENAI_API_KEY is empty, the demo also accepts ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# Demo metadata shown in spans.
LANGFUSE_TRACING_ENVIRONMENT=local
